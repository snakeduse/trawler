{application, trawler,
 [{description, "Embeddable IPv4 TCP scanner: project foundation"},
  {vsn, "0.1.0-dev"},
  {registered, [trawler_sup, trawler_scheduler, trawler_scan_registry,
                trawler_scan_sup, trawler_discovery_registry,
                trawler_discovery_sup]},
  {mod, {trawler_app, []}},
  {applications, [kernel, stdlib]},
  {env, [{max_hosts, 65536}, {max_concurrency, 256}]},
  {modules, []},
  {licenses, ["Apache-2.0"]}]}.
