#!/usr/bin/env bash
set -euo pipefail
source "$(dirname -- "${BASH_SOURCE[0]}")/env.sh" all
cd "${TRAWLER_ROOT}"
if ! command -v openspec >/dev/null; then
    echo "Install OpenSpec globally: npm install -g @fission-ai/openspec@1.14.1" >&2
    exit 1
fi
if [[ "$(openspec --version)" != "1.14.1" ]]; then
    echo "Expected globally installed OpenSpec 1.14.1." >&2
    exit 1
fi
export OPENSPEC_TELEMETRY=0
export OPENSPEC_NO_UPDATE_CHECK=1
exec openspec "$@"
