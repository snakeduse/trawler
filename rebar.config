{minimum_otp_vsn, "27.0"}.
{erl_opts, [debug_info, warnings_as_errors, warn_unused_vars,
            warn_unused_import, warn_missing_spec]}.
{deps, []}.
{shell, [{apps, [trawler]}]}.
{escript_name, "trawler"}.
{escript_main_app, trawler}.
{escript_emu_args, "%%! -escript main trawler_cli\n"}.
{eunit_opts, [verbose]}.
{ct_opts, [{dir, "test"}]}.
{xref_checks, [undefined_function_calls, undefined_functions,
               locals_not_used, deprecated_function_calls]}.
{dialyzer, [{warnings, [unmatched_returns, error_handling, underspecs]},
            {plt_apps, top_level_deps}]}.
{profiles, [{test, [{erl_opts, [nowarn_missing_spec]}]}]}.
